---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Noeta" description="That page does not exist." path="/404">
  <main>
    <section class="hero wrap">
      <p class="eyebrow reveal" style="--d: 0">E0404</p>
      <h1 class="reveal" style="--d: 1">This state is <span class="human">unrepresentable.</span></h1>
      <p class="dek reveal" style="--d: 2">The page you asked for doesn't compile. Head back to the start.</p>
      <div class="cta-row reveal" style="--d: 3">
        <a class="btn btn-primary" href="/">← noeta.dev</a>
      </div>
    </section>
  </main>
</Base>
