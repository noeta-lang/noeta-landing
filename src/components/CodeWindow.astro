---
/* A terminal-chromed code window: filename bar, highlighted Noeta source, and
 * an optional command footer with a live caret. Highlighting runs at build
 * time through the canonical TextMate grammar (src/lib/noeta-highlight.mjs);
 * the helper returns inner spans only, so the pre/code chrome below and the
 * .code-window styles in theme.css are unchanged. */
import { highlightNoeta } from "../lib/noeta-highlight.mjs";

interface Props {
  file: string;
  code: string;
  /** Shell line shown under the code, e.g. "noeta serve counter.noe --watch". */
  command?: string;
  class?: string;
}

const { file, code, command, class: className } = Astro.props;
const html = await highlightNoeta(code.trim());
---

<figure class:list={["code-window", className]}>
  <div class="bar">
    <span class="dot lit"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="file">{file}</span>
  </div>
  <pre><code set:html={html} /></pre>
  {
    command && (
      <figcaption class="foot">
        <span class="prompt">$</span>
        <span>{command}</span>
        <span class="caret" aria-hidden="true" />
      </figcaption>
    )
  }
</figure>
