---
/* Page shell: the shared @noeta/theme "Signal" design system (fonts + tokens +
 * chrome), this site's own page layout, head, and the fixed atmospheric
 * background layer. */
import "@noeta/theme/fonts.css";
import "@noeta/theme/theme.css";
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import { renderHeader, renderFooter, DRAWER_SCRIPT } from "@noeta/theme/chrome";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path={path} />
  </head>
  <body>
    <div class="field" aria-hidden="true"></div>
    <Fragment set:html={renderHeader({ site: "home", version: SITE.version })} />
    <slot />
    <Fragment set:html={renderFooter({ site: "home" })} />
    <script is:inline set:html={DRAWER_SCRIPT} />
  </body>
</html>
