{
  "name": "noeta-landing",
  "version": "0.1.0",
  "private": true,
  "description": "The Noeta landing page \u2014 the marketing/entry site at the noeta.dev root.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "sync-grammars": "node scripts/sync-grammars.mjs",
    "predev": "node scripts/sync-grammars.mjs",
    "prebuild": "node scripts/sync-grammars.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-og-image.mjs",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "astro check",
    "check:overflow": "node node_modules/@noeta/theme/scripts/check-overflow.mjs --dist dist",
    "check:chrome": "node node_modules/@noeta/theme/scripts/check-chrome.mjs --dist dist"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^7.0.9",
    "playwright-core": "^1.61.1",
    "shiki": "^4.3.1",
    "typescript": "^5.9.3",
    "wrangler": "~4.112.0"
  },
  "dependencies": {
    "@noeta/theme": "file:../noeta-theme"
  }
}
